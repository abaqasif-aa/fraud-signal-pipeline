FROM python:3.11-slim

WORKDIR /app

# Install AWS and utility dependencies
RUN pip install --no-cache-dir \
    boto3==1.34.0 \
    psycopg2-binary==2.9.9 \
    pandas==2.1.4 \
    awscli==1.32.0

# Copy all project scripts
COPY ../../infrastructure/aws/ ./infrastructure/aws/
COPY ../../ml/ ./ml/
COPY ../../quality/ ./quality/
COPY ../../data_contracts/ ./data_contracts/

